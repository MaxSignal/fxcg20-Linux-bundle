# The kernel that runs in place from the flash, with the romfs root file
# system packed below it (scripts/build-xip.sh, on top of
# arch/sh/configs/fxcg20_defconfig; XIP_PHYS_ADDR is set by the script).
CONFIG_XIP_KERNEL=y
# CONFIG_BLK_DEV_INITRD is not set
CONFIG_MTD=y
CONFIG_MTD_ROM=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_ROMFS_FS=y
CONFIG_ROMFS_BACKED_BY_MTD=y
CONFIG_FXCG_XIP_ROMFS=y
CONFIG_CMDLINE_OVERWRITE=y
CONFIG_CMDLINE="console=ttyFX0 root=mtd0 rootfstype=romfs"

# Options on top of arch/sh/configs/fxcg20_defconfig, checked after the
# configuration is made (scripts/build-kernel.sh).
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_CMDLINE_OVERWRITE=y
CONFIG_CMDLINE="console=ttyFX0 rdinit=/sbin/init"
# /dev/xipflash, to install the kernel that runs in place (build-xip.sh)
CONFIG_FXCG_XIP_INSTALL=y

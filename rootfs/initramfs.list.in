# gen_init_cpio list for the fx-CG20 root file system
dir /dev 755 0 0
nod /dev/console 600 0 0 c 5 1
nod /dev/tty 666 0 0 c 5 0
nod /dev/ptmx 666 0 0 c 5 2
dir /dev/pts 755 0 0
nod /dev/ttyFX0 600 0 0 c 254 0
nod /dev/null 666 0 0 c 1 3
nod /dev/zero 666 0 0 c 1 5
nod /dev/full 666 0 0 c 1 7
nod /dev/random 666 0 0 c 1 8
nod /dev/urandom 666 0 0 c 1 9
nod /dev/xipflash 200 0 0 c 10 240
nod /dev/ncm 600 0 0 c 10 241
dir /proc 755 0 0
dir /sys 755 0 0
dir /tmp 1777 0 0
dir /root 700 0 0
dir /mnt 755 0 0
dir /mnt/fls 755 0 0
dir /bin 755 0 0
dir /sbin 755 0 0
dir /usr 755 0 0
dir /usr/bin 755 0 0
dir /usr/sbin 755 0 0
dir /etc 755 0 0
dir /etc/init.d 755 0 0
file /etc/inittab @INITTAB@ 644 0 0
file /etc/init.d/rcS @ROOTFS@/etc/init.d/rcS 755 0 0
file /etc/profile @ROOTFS@/etc/profile 644 0 0
file /bin/busybox @BUSYBOX@ 755 0 0 @LINKS@
file /sbin/ncmd @NCMD@ 755 0 0

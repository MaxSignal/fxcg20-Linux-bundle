# BusyBox for the fx-CG20: nommu, static FDPIC, small.
# Applied on top of "make allnoconfig" by scripts/build-rootfs.sh.
CONFIG_STATIC=y
CONFIG_NOMMU=y
CONFIG_EXTRA_CFLAGS="-Os"
CONFIG_LFS=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=256
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_HUMAN_READABLE=y
# init
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_QUIET=y
CONFIG_HALT=y
# CONFIG_FEATURE_CALL_TELINIT is not set
# shell: ash needs an MMU, hush works on nommu
CONFIG_SH_IS_HUSH=y
CONFIG_HUSH=y
CONFIG_SHELL_HUSH=y
CONFIG_HUSH_INTERACTIVE=y
CONFIG_HUSH_JOB=y
CONFIG_HUSH_TICK=y
CONFIG_HUSH_IF=y
CONFIG_HUSH_LOOPS=y
CONFIG_HUSH_CASE=y
CONFIG_HUSH_FUNCTIONS=y
CONFIG_HUSH_EXPORT=y
CONFIG_HUSH_ECHO=y
CONFIG_HUSH_TEST=y
CONFIG_HUSH_KILL=y
CONFIG_HUSH_WAIT=y
CONFIG_HUSH_TRAP=y
CONFIG_HUSH_TYPE=y
CONFIG_HUSH_READ=y
CONFIG_HUSH_SET=y
CONFIG_HUSH_UNSET=y
CONFIG_HUSH_EXEC=y
CONFIG_HUSH_CD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y
# coreutils
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CP=y
CONFIG_DF=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_HEAD=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_WIDTH=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_SYNC=y
CONFIG_TAIL=y
CONFIG_TEST=y
CONFIG_TOUCH=y
CONFIG_TRUE=y
CONFIG_UNAME=y
CONFIG_UPTIME=y
CONFIG_WC=y
CONFIG_CLEAR=y
CONFIG_VI=y
CONFIG_FEATURE_VI_MAX_LEN=256
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_MORE=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_DMESG=y
CONFIG_FREE=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_FEATURE_EDITING_HISTORY=8
# CONFIG_FLOAT_DURATION is not set
# CONFIG_FEATURE_MOUNT_NFS is not set
# CONFIG_FEATURE_MOUNT_CIFS is not set
# CONFIG_FEATURE_MOUNT_HELPERS is not set
# CONFIG_FEATURE_MOUNT_LABEL is not set
CONFIG_EXTRA_LDFLAGS="-Wl,-z,max-page-size=4096 -Wl,-z,common-page-size=4096 -Wl,-z,stack-size=24576"

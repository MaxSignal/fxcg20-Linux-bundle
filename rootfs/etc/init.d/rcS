#!/bin/sh
mount -t proc proc /proc
mount -t tmpfs -o size=128k tmpfs /tmp
# the Casio storage memory, read only
mount -t fls fls /mnt/fls 2>/dev/null
# the network over USB, when the kernel has /dev/ncm
ncmd >/dev/null 2>&1 &

# what the loader asked for (F2: install the flash part of linuxf.bin,
# then reset to boot it; F6: remove it)
case " $(cat /proc/cmdline) " in
*" fxcg.boot=install "*)
	echo "Installing flash.bin in the flash..."
	if cat /mnt/fls/flash.bin > /dev/xipflash; then
		echo "Installed. Resetting: run Linux again, F2 boots it."
		sleep 3
		exec reboot
	fi
	echo "The install failed (see dmesg)."
	;;
*" fxcg.boot=remove "*)
	if echo -n fxcgRMV1 > /dev/xipflash; then
		echo "The flash part is removed."
	else
		echo "Removing it failed (see dmesg)."
	fi
	;;
esac

echo
echo "Welcome to Linux on the Casio fx-CG20!"
uname -sr
free | head -n 2
echo "Keys: ALPHA=letters SHIFT=symbols OPTN=TAB EXE=Enter AC=^C"
echo "MENU=Ctrl  MENU +/-=backlight  SHIFT AC=sleep, AC wakes up"
echo

libbb: C locale wide character classes for fnmatch

musl's iswalpha, iswpunct, towlower and towupper bring in 13 KiB of Unicode
tables; BusyBox only runs in the C locale.

--- /dev/null
+++ b/libbb/wctype_c.c
@@ -0,0 +1,54 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * The wide character classes that musl's fnmatch uses, for the C locale
+ * only. BusyBox never sets a locale; in the C locale musl's mbtowc gives
+ * ASCII, or 0xdf80-0xdfff for the other bytes, which are neither letters
+ * nor punctuation. musl's versions bring in 13 KiB of Unicode tables.
+ * Linked as an object: only libc refers to these.
+ *
+ * Licensed under GPLv2 or later, see file LICENSE in this source tree.
+ */
+//kbuild:obj-y += wctype_c.o
+
+#include "libbb.h"
+#include <wctype.h>
+
+int iswalpha(wint_t c)
+{
+	return (c | 0x20) - 'a' < 26;
+}
+
+int __iswalpha_l(wint_t c, locale_t l UNUSED_PARAM)
+{
+	return iswalpha(c);
+}
+
+int iswpunct(wint_t c)
+{
+	return c - '!' < '~' - '!' + 1 && !iswalnum(c);
+}
+
+int __iswpunct_l(wint_t c, locale_t l UNUSED_PARAM)
+{
+	return iswpunct(c);
+}
+
+wint_t towlower(wint_t c)
+{
+	return c - 'A' < 26 ? c | 0x20 : c;
+}
+
+wint_t towupper(wint_t c)
+{
+	return c - 'a' < 26 ? c & ~0x20 : c;
+}
+
+wint_t __towlower_l(wint_t c, locale_t l UNUSED_PARAM)
+{
+	return towlower(c);
+}
+
+wint_t __towupper_l(wint_t c, locale_t l UNUSED_PARAM)
+{
+	return towupper(c);
+}

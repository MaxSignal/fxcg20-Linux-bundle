mount: without FEATURE_MOUNT_NFS, no "host:dir" mounts

The fallback for "host:dir" sources resolves the host name, which links
the libc resolver even with no networking.

--- a/util-linux/mount.c
+++ b/util-linux/mount.c
@@ -2089,7 +2089,8 @@
 	}
 
 	// Might this be an NFS filesystem?
-	if (!(vfsflags & (MS_BIND | MS_MOVE))
+	if (ENABLE_FEATURE_MOUNT_NFS
+	 && !(vfsflags & (MS_BIND | MS_MOVE))
 	 && (!mp->mnt_type || is_prefixed_with(mp->mnt_type, "nfs"))
 	) {
 		char *colon = strchr(mp->mnt_fsname, ':');
